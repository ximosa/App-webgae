# Puerto local de desarrollo
PORT=3000

# URL pública de la aplicación (utilizada para retornos de PayPal y enlaces de confirmación)
APP_URL="http://localhost:3000"

# Modo de PayPal: 'sandbox' para pruebas o 'live' para producción real
PAYPAL_MODE="sandbox"

# Credenciales de la aplicación REST de PayPal Developer (https://developer.paypal.com/dashboard/applications)
# Obtenidas en tu cuenta PayPal Business -> Apps & Credentials
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# ID del Webhook configurado en PayPal Developer para recibir notificaciones automáticas de pago y reembolso
PAYPAL_WEBHOOK_ID=""

# Moneda oficial de contratación
PAYPAL_CURRENCY="EUR"

# Correo para avisos administrativos de nuevos pedidos y presupuestos
ADMIN_NOTIFICATION_EMAIL="ximosagmail.com"

# (Opcional) Proveedor de Email transaccional Resend para enviar avisos automáticos por correo (https://resend.com)
RESEND_API_KEY=""

# (Opcional) Webhook para recibir aviso instantáneo en tu móvil (Discord, Telegram bot o Slack)
ADMIN_ALERT_WEBHOOK_URL=""

# (Opcional) Clave secreta para consultar /api/admin/orders?secret=tu_clave
ADMIN_SECRET_KEY="clave_secreta_administrador"



# WhatsApp de contacto, formato internacional solo dígitos (ej. 34600111222)
VITE_WHATSAPP_NUMBER=
# Email donde recibirás consultas (requiere RESEND_API_KEY)
ADMIN_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL="Webgae Contacto <onboarding@resend.dev>"
