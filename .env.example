# Puerto local de desarrollo
PORT=3000

# URL pública de la aplicación (utilizada para retornos de PayPal y enlaces de confirmación)
APP_URL="http://localhost:3000"

# Modo de PayPal: 'sandbox' para pruebas o 'live' para producción real
PAYPAL_MODE="sandbox"

# Credenciales de la aplicación REST de PayPal Developer (https://developer.paypal.com/dashboard/applications)
# Obtenidas en tu cuenta PayPal Business -> Apps & Credentials
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# ID del Webhook configurado en PayPal Developer para recibir notificaciones automáticas de pago y reembolso
PAYPAL_WEBHOOK_ID=""

# Moneda oficial de contratación
PAYPAL_CURRENCY="EUR"

# Correo para avisos administrativos de nuevos pedidos y presupuestos (opcional)
ADMIN_NOTIFICATION_EMAIL="pedidos@devpro.local"

# GEMINI_API_KEY: Inyectado por el entorno si se requiere
GEMINI_API_KEY=""
